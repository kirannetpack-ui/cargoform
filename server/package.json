{
  "name": "cargoform-api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "worker:email": "tsx src/email-worker.ts",
    "bootstrap:admin": "tsx src/bootstrap-admin.ts",
    "test": "tsx --test test/policy.test.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1112.0",
    "@aws-sdk/s3-request-presigner": "^3.1112.0",
    "@node-rs/argon2": "^2.1.0",
    "@prisma/client": "6.19.3",
    "cookie-parser": "1.4.7",
    "cors": "2.8.5",
    "dotenv": "^16.6.1",
    "express": "5.1.0",
    "googleapis": "174.0.1",
    "helmet": "8.1.0",
    "jose": "6.1.0",
    "otplib": "^13.4.1",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "prom-client": "^15.1.3",
    "prisma": "6.19.3",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/cookie-parser": "1.4.9",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.5",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  }
}
